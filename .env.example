# ── FREE setup (no payment, no GPU) ─────────────────────────────────
# Option A: OpenRouter free tier ($0, 20 req/min, 200 req/day)
#   1. Sign up at https://openrouter.ai — free account
#   2. Copy your API key below
INFERENCE_PROVIDER=openrouter_free
INFERENCE_API_KEY=your-openrouter-api-key

# Option B: Groq free tier (very fast, 30 req/min)
#   1. Sign up at https://console.groq.com — free account
#   2. Copy your API key below
# INFERENCE_PROVIDER=groq
# GROQ_API_KEY=gsk_your_key_here

# Option C: HuggingFace free tier (rate-limited)
#   1. Sign up at https://huggingface.co — free account
#   2. Create a token at https://huggingface.co/settings/tokens
# INFERENCE_PROVIDER=huggingface
# HF_TOKEN=hf_your_token_here

# ── Paid providers (faster, higher limits) ──────────────────────────
# INFERENCE_PROVIDER=fireworks    # ~$0.20/M tokens
# INFERENCE_PROVIDER=together     # ~$0.50/M input
# INFERENCE_PROVIDER=openrouter   # ~$0.08/M input (paid tier)
# INFERENCE_PROVIDER=dashscope    # pay-per-use (Alibaba Cloud)
# INFERENCE_PROVIDER=vllm         # free but needs GPU

# --- Provider-specific model overrides (optional) ---
# FIREWORKS_MODEL=accounts/fireworks/models/qwen3-vl-8b-instruct
# TOGETHER_MODEL=Qwen/Qwen3-VL-32B-Instruct
# OPENROUTER_MODEL=qwen/qwen3-vl-8b-instruct
# DASHSCOPE_MODEL=qwen3-vl-8b-instruct
# OPENROUTER_FREE_MODEL=qwen/qwen3-vl-235b-a22b-thinking:free
# HF_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Local vLLM settings (only when INFERENCE_PROVIDER=vllm) ---
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct
# VLLM_PORT=8000
# VLLM_GPU_MEMORY_UTIL=0.85
# VLLM_MAX_MODEL_LEN=4096

# --- Application server ---
APP_HOST=0.0.0.0
APP_PORT=8080

# --- Video processing ---
# MAX_FRAMES_PER_VIDEO=16
# MAX_VIDEO_SIZE_MB=100
