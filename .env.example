# Inference provider: vllm | fireworks | together | openrouter | dashscope
INFERENCE_PROVIDER=fireworks

# API key for the chosen cloud provider (not needed for local vLLM)
INFERENCE_API_KEY=your-api-key-here

# --- Provider-specific model overrides (optional) ---
# FIREWORKS_MODEL=accounts/fireworks/models/qwen3-vl-8b-instruct
# TOGETHER_MODEL=Qwen/Qwen3-VL-32B-Instruct
# OPENROUTER_MODEL=qwen/qwen3-vl-8b-instruct
# DASHSCOPE_MODEL=qwen3-vl-8b-instruct

# --- Local vLLM settings (only when INFERENCE_PROVIDER=vllm) ---
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct
# VLLM_PORT=8000
# VLLM_GPU_MEMORY_UTIL=0.85
# VLLM_MAX_MODEL_LEN=4096

# --- Application server ---
APP_HOST=0.0.0.0
APP_PORT=8080

# --- Video processing ---
# MAX_FRAMES_PER_VIDEO=16
# MAX_VIDEO_SIZE_MB=100
