# ── FREE setup (no payment, no GPU) ─────────────────────────────────
# Option A: OpenRouter free tier ($0, 20 req/min, 200 req/day)
#   1. Sign up at https://openrouter.ai — free account
#   2. Copy your API key below
INFERENCE_PROVIDER=openrouter_free
INFERENCE_API_KEY=your-openrouter-api-key

# Option B: Groq free tier (very fast, 30 req/min)
#   1. Sign up at https://console.groq.com — free account
#   2. Copy your API key below
# INFERENCE_PROVIDER=groq
# GROQ_API_KEY=gsk_your_key_here

# Option C: HuggingFace free tier (rate-limited)
#   1. Sign up at https://huggingface.co — free account
#   2. Create a token at https://huggingface.co/settings/tokens
# INFERENCE_PROVIDER=huggingface
# HF_TOKEN=hf_your_token_here

# ── Paid providers (faster, higher limits) ──────────────────────────
# INFERENCE_PROVIDER=fireworks    # ~$0.20/M tokens
# INFERENCE_PROVIDER=together     # ~$0.50/M input
# INFERENCE_PROVIDER=openrouter   # ~$0.08/M input (paid tier)
# INFERENCE_PROVIDER=dashscope    # pay-per-use (Alibaba Cloud)
# INFERENCE_PROVIDER=vllm         # free but needs GPU

# --- Provider-specific model overrides (optional) ---
# FIREWORKS_MODEL=accounts/fireworks/models/qwen3-vl-8b-instruct
# TOGETHER_MODEL=Qwen/Qwen3-VL-32B-Instruct
# OPENROUTER_MODEL=qwen/qwen3-vl-8b-instruct
# DASHSCOPE_MODEL=qwen3-vl-8b-instruct
# OPENROUTER_FREE_MODEL=qwen/qwen3-vl-235b-a22b-thinking:free
# HF_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Local vLLM settings (only when INFERENCE_PROVIDER=vllm) ---
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct
# VLLM_PORT=8000
# VLLM_GPU_MEMORY_UTIL=0.85
# VLLM_MAX_MODEL_LEN=4096

# --- Application server ---
APP_HOST=0.0.0.0
APP_PORT=8080

# --- Video processing ---
# MAX_FRAMES_PER_VIDEO=16
# MAX_VIDEO_SIZE_MB=100

# --- Instagram authentication (for downloading reels with yt-dlp) ---
# Option 1: Export cookies from your browser (recommended)
#   1. Log into Instagram in Chrome/Firefox
#   2. Install "Get cookies.txt LOCALLY" browser extension
#   3. Export cookies for instagram.com → save as data/cookies.txt
# INSTAGRAM_COOKIES_FILE=data/cookies.txt
#
# Option 2: Let yt-dlp read cookies directly from your browser
#   (requires browser to be closed; values: chrome, firefox, edge, safari, brave)
# INSTAGRAM_COOKIES_FROM_BROWSER=chrome

# ── AI Video Generation (for generating new viral Reels) ─────────────
#
# FREE option A — Google Veo 3 (BEST free quality, 720p, ~10 gen/day):
#   1. Go to https://aistudio.google.com/apikey (free, no credit card)
#   2. Click "Create API Key"
# GOOGLE_API_KEY=your-google-api-key
#   python3 scripts/generate_reels.py --provider veo3         # Best free quality
#
# FREE option B — HuggingFace Spaces (no API key at all):
#   python3 scripts/generate_reels.py --provider ltx          # Good free quality
#   python3 scripts/generate_reels.py --provider cogvideo5b   # Highest quality HF
#   python3 scripts/generate_reels.py --provider cogvideo2b   # Fastest free
#
# Optional: HuggingFace token for 5x more free GPU quota:
#   1. Sign up at https://huggingface.co/join (free)
#   2. Get token at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_token_here
#
# PAID option — higher quality, faster, uses fal.ai unified API:
#   1. Sign up at https://fal.ai — pay-per-use, no subscription
#   2. Get API key from https://fal.ai/dashboard/keys
# FAL_KEY=your-fal-api-key
#
# Available paid providers (set via --provider flag):
#   kling3   — Kling 3.0 Pro ($0.029/sec, cheapest paid)
#   kling26  — Kling 2.6 Pro ($0.07/sec)
#   veo3_fal — Google Veo 3 via fal.ai ($0.40/sec, highest quality)
#   minimax  — MiniMax Video 01 ($0.10/sec, fastest)
#   sora     — OpenAI Sora 2 ($0.10/sec, requires OPENAI_API_KEY)
#   runway   — Runway Gen-4 Turbo (requires RUNWAYML_API_SECRET)
#
# OPENAI_API_KEY=sk-your-openai-key
# RUNWAYML_API_SECRET=key-your-runway-key
